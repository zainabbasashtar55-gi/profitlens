APP_NAME=ProfitLens
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
TENANT_DOMAIN=profitlens.test
CENTRAL_DOMAINS=127.0.0.1,localhost,profitlens.test,127.0.0.1.nip.io
TENANCY_POSTGRES_SCHEMAS=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Stripe (laravel/cashier) — leave empty for dev mode (no payment)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US

SLACK_SIGNING_SECRET=
DISCORD_PUBLIC_KEY=

CASHIER_CURRENCY=usd
CASHIER_CURRENCY_LOCALE=en

# Anthropic (Claude) — intelligence features. Empty = rule-based fallbacks.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_VISION=claude-opus-4-8
ANTHROPIC_MODEL_CATEGORIZE=claude-haiku-4-5
ANTHROPIC_MODEL_CHAT=claude-opus-4-8

VITE_APP_NAME="${APP_NAME}"
